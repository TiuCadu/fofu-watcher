{
  "name": "fofu-watcher",
  "version": "1.6.2",
  "private": true,
  "license": "MIT",
  "description": "Extensão MV3 (Chrome/Brave) que monitora sites e avisa quando o conteúdo muda.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node test/run.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/node": "^24.19.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
